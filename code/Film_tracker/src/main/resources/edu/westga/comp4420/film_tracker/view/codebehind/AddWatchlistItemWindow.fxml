<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER_LEFT" spacing="10.0"
      xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.westga.comp4420.film_tracker.view.codebehind.AddWatchlistItemWindow">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <Label text="Type" />
   <HBox spacing="10.0">
      <ToggleButton fx:id="filmButton" mnemonicParsing="false" selected="true" text="Film">
         <toggleGroup>
            <ToggleGroup fx:id="itemTypeGroup" />
         </toggleGroup>
      </ToggleButton>
      <ToggleButton fx:id="seriesButton" mnemonicParsing="false" text="Series" toggleGroup="$itemTypeGroup" />
   </HBox>
   <Label text="Title" />
   <TextField fx:id="titleField" promptText="Title of the films or series" />
   <HBox alignment="CENTER_RIGHT" spacing="10.0">
      <Button mnemonicParsing="false" onAction="#cancel" text="Cancel" />
      <Button defaultButton="true" mnemonicParsing="false" onAction="#addItem" text="Add" />
   </HBox>
</VBox>
